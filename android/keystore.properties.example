# Copier vers keystore.properties (fichier ignoré par Git) et remplir les mots de passe.
# Les chemins storeFile sont relatifs au dossier android/
#
# Option A — keystore dans le repo (souvent android/app/) :
# storeFile=app/upload-keystore.jks
#
# Option B — keystore ailleurs (ex. ../Dev/ depuis la racine du disque Projet) :
# storeFile=../../Dev/upload-keystore.jks
#
# L’alias est celui affiché par : keytool -list -keystore CHEMIN (ex. mykey, upload).
# Vérifier l’empreinte : keytool -list -v -keystore CHEMIN -alias ALIAS
# SHA1 doit correspondre à la clé d’upload enregistrée sur Play Console.

storeFile=../../Dev/upload-keystore.jks
storePassword=REMPLACER
keyAlias=mykey
keyPassword=REMPLACER
